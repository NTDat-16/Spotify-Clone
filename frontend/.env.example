# ===== Frontend Environment Variables (Vercel project: spotify-clone-14) =====
# VITE_API_ORIGIN = URL gốc của Django backend, KHÔNG có /api ở cuối.
# Frontend sẽ gọi ${VITE_API_ORIGIN}/api/songs/ ... v.v.

# Local development:
VITE_API_ORIGIN=http://localhost:8000

# Production (deploy trên Vercel):
# VITE_API_ORIGIN=https://spotify-clone-be-psi.vercel.app
