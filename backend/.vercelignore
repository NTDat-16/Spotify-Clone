venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Local environment & secrets
.env
.env.local

# Database dumps and documentation
data.sql
info.txt
package-lock.json
db.sqlite3

