# Django / Vercel. Generate a strong unique value; never commit the real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Production Database (Supabase PostgreSQL / Neon PostgreSQL on Vercel):
# For Supabase, copy the pooler string (port 6543) and keep ?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUPABASE_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Local Development MySQL (used only when DATABASE_URL is not provided):
MYSQL_DATABASE=spotify_clone
MYSQL_USER=root
MYSQL_PASSWORD=141516
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Backend public hostnames (comma-separated). .vercel.app is allowed by default.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Frontend origins (comma-separated; no trailing slash or /api)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# PayPal configuration
PAYPAL_CLIENT_ID=AY5SLnZXMLzSQwqlHiq1fI3x5HhGR994zmFQqXxUOkFng9WV50Lg3hZerAv9pa5NFvmgLliOqTTowgmW
