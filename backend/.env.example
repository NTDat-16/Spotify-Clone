# ===== Backend Environment Variables (Vercel project: spotify-clone-be) =====
# Copy các biến này vào Vercel Dashboard > Project > Settings > Environment Variables.
# KHÔNG commit file DATABASE_URL thật vào GitHub.

# Supabase PostgreSQL connection string (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres.yourref:YOUR_PASSWORD@aws-0-...pooler.supabase.com:5432/postgres

# Bí mật Django (tạo chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=your-secret-key

DEBUG=False

# Cho phép backend domain + localhost (KHÔNG thêm https:// vào host)
ALLOWED_HOSTS=localhost,127.0.0.1,spotify-clone-be-psi.vercel.app

# Frontend domain gọi API (KHÔNG thêm slash cuối)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://spotify-clone-14.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://spotify-clone-14.vercel.app

# PayPal (giữ nguyên nếu đang dùng)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
